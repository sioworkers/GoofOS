# runs at boot, a tiny command loop

func show_help()
    output "help   show this"
    output "add    add two numbers"
    output "greet  say hi"
    output "fact   factorial, with recursion"
    output "write  write a file"
    output "read   show a file"
    output "files  list files"
    output "uptime show time since boot"
    output "sleep  wait for a while"
    output "cls    clear the screen"
    output "halt   stop the cpu"
end

# adds a line and its newline, gives 0 if the disk is full
func append_line(name, line)
    if file_append(name, line) == 0
        return 0
    end
    return file_append(name, "\n")
end

# asks for a name, then saves every line until EOF into that file
func edit_file()
    print "File Name: "
    input_line name
    if name == ""
        return
    end
    if file_write(name, "") == 0
        output "can't write '" + name + "'"
        return
    end
    output "Text (Type EOF to write):"
    while 1
        input_line line
        if line == "EOF"
            break
        end
        if append_line(name, line) == 0
            output "disk full, '" + name + "' is cut short"
            return
        end
    end
    output "saved " + name
end

func show_file()
    print "File Name: "
    input_line name
    if file_print(name) == 0
        output "no file '" + name + "'"
    end
end

func ask_number(prompt)
    print prompt
    input value
    return value
end

func greet(name)
    if name == ""
        output "hi, whoever you are"
    else
        output "hi " + name + "!"
    end
end

func factorial(n)
    if n > 1
        return n * factorial(n - 1)
    end
    return 1
end

output "type help for commands"

while 1
    print "> "
    input_line command
    if command == ""
        continue
    else if command == "help"
        show_help()
    else if command == "add"
        a = ask_number("a: ")
        b = ask_number("b: ")
        output a + " + " + b + " = " + (a + b)
    else if command == "greet"
        print "name: "
        input_line name
        greet(name)
    else if command == "fact"
        n = ask_number("n: ")
        output n + "! = " + factorial(n)
    else if command == "write"
        edit_file()
    else if command == "read"
        show_file()
    else if command == "files"
        file_list()
    else if command == "uptime"
        output "up " + uptime() / 1000 + "s"
    else if command == "sleep"
        sleep(ask_number("ms: "))
    else if command == "cls"
        clear
    else if command == "halt"
        output "bye!"
        halt
    else
        output "unknown command '" + command + "', try help"
    end
end
