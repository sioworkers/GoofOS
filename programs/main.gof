# runs at boot, a tiny command loop

func show_help()
    output "help   show this"
    output "add    add two numbers"
    output "greet  say hi"
    output "fact   factorial, with recursion"
    output "cls    clear the screen"
    output "halt   stop the cpu"
end

func ask_number(prompt)
    print prompt
    input value
    return value
end

func greet(name)
    if name == "" goto nobody
    output "hi " + name + "!"
    return
    nobody:
    output "hi, whoever you are"
end

func factorial(n)
    if n > 1 goto more
    return 1
    more:
    return n * factorial(n - 1)
end

output "type help for commands"

loop:
print "> "
input_line command
if command == "" goto loop
if command == "help" goto help
if command == "add" goto add
if command == "greet" goto greet
if command == "fact" goto fact
if command == "cls" goto cls
if command == "halt" goto stop
output "unknown command '" + command + "', try help"
goto loop

help:
show_help()
goto loop

add:
a = ask_number("a: ")
b = ask_number("b: ")
output a + " + " + b + " = " + (a + b)
goto loop

greet:
print "name: "
input_line name
greet(name)
goto loop

fact:
n = ask_number("n: ")
output n + "! = " + factorial(n)
goto loop

cls:
clear
goto loop

stop:
output "bye!"
halt
