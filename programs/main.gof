# runs at boot, a tiny command loop

func show_help()
    output "help   show this"
    output "add    add two numbers"
    output "greet  say hi"
    output "fact   factorial, with recursion"
    output "write  write a file"
    output "read   show a file"
    output "files  list files"
    output "cls    clear the screen"
    output "halt   stop the cpu"
end

# asks for a name, then saves every line until EOF into that file
func edit_file()
    print "File Name: "
    input_line name
    if name == "" goto done
    if file_write(name, "") goto start
    output "can't write '" + name + "'"
    return
    start:
    output "Text (Type EOF to write):"
    next:
    input_line line
    if line == "EOF" goto saved
    if file_append(name, line) == 0 goto full
    if file_append(name, "\n") == 0 goto full
    goto next
    full:
    output "disk full, '" + name + "' is cut short"
    return
    saved:
    output "saved " + name
    done:
end

func show_file()
    print "File Name: "
    input_line name
    if file_print(name) goto done
    output "no file '" + name + "'"
    done:
end

func ask_number(prompt)
    print prompt
    input value
    return value
end

func greet(name)
    if name == "" goto nobody
    output "hi " + name + "!"
    return
    nobody:
    output "hi, whoever you are"
end

func factorial(n)
    if n > 1 goto more
    return 1
    more:
    return n * factorial(n - 1)
end

output "type help for commands"

loop:
print "> "
input_line command
if command == "" goto loop
if command == "help" goto help
if command == "add" goto add
if command == "greet" goto greet
if command == "fact" goto fact
if command == "write" goto write
if command == "read" goto read
if command == "files" goto files
if command == "cls" goto cls
if command == "halt" goto stop
output "unknown command '" + command + "', try help"
goto loop

help:
show_help()
goto loop

add:
a = ask_number("a: ")
b = ask_number("b: ")
output a + " + " + b + " = " + (a + b)
goto loop

greet:
print "name: "
input_line name
greet(name)
goto loop

fact:
n = ask_number("n: ")
output n + "! = " + factorial(n)
goto loop

write:
edit_file()
goto loop

read:
show_file()
goto loop

files:
file_list()
goto loop

cls:
clear
goto loop

stop:
output "bye!"
halt
